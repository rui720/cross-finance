# ============================================================
# cross-finance 环境变量示例
# ------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env（位于项目根目录或 backend/ 下）
#   2. 填入真实值
#   3. .env 文件已被 .gitignore 排除，不会提交到仓库
#
#   Windows PowerShell 临时设置（仅当前会话）：
#     $env:MYSQL_PASSWORD = "your_password"
#   或在 IDE 运行配置的 Environment variables 中填写：
#     MYSQL_PASSWORD=your_password;JWT_SECRET=xxx;LANGCHAIN_API_KEY=sk-xxx
# ============================================================

# ---------- MySQL 数据库 ----------
# 数据库连接 URL（生产环境务必改用内网域名/IP，并启用 useSSL=true）
MYSQL_URL=jdbc:mysql://localhost:3306/cross_finance?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ---------- JWT 密钥 ----------
# 生产环境必须注入 ≥256 bit 随机串（建议使用 openssl rand -base64 48 生成）
# 格式示例：myG9K2xP3qR7sT1vU4wX6yZ8aB0cD5eF7gH2jK4mL9nP1qR3sT5uV7wX9yZ
JWT_SECRET=

# ---------- DeepSeek / LangChain4j 大模型 ----------
# 前往 https://platform.deepseek.com/ 申请 API Key
LANGCHAIN_API_KEY=

# ---------- 可选：Redis（若启用缓存） ----------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
