# ============================================================
# 根目录通用忽略规则（适用于整个 cross-finance 项目）
# ============================================================

# ===== 敏感配置文件（禁止入库）=====
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-prod.yml
application-prod.yaml
application-secret.yml
*.pem
*.key
*.p12
*.jks
credentials.json
serviceAccountKey.json

# ===== 操作系统生成文件 =====
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ===== IDE / 编辑器 =====
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
.springBeans

# ===== 构建产物 / 缓存 =====
target/
build/
out/
dist/
dist-ssr/
*.local

# ===== 日志 =====
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== 依赖目录 =====
node_modules/
.npm-cache/
.yarn/cache
.pnpm-store/

# ===== 前端 =====
.vite/
.vite-cache/

# ===== 后端 =====
.mvn/wrapper/maven-wrapper.jar
HELP.md

# ===== 数据库备份 / dump =====
*.dump
*.sql.bak
*.bak
db_backup/

# ===== 临时文件 =====
*.tmp
*.temp
*.cache
